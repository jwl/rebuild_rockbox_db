diff --git a/src/dap_db_manager/constants.py b/src/dap_db_manager/constants.py
index bbf6bc3..2ba2fe5 100644
--- a/src/dap_db_manager/constants.py
+++ b/src/dap_db_manager/constants.py
@@ -44,6 +44,53 @@ FORMATTED_TAGS = FILE_TAGS[:3] + FILE_TAGS[5:]
 
 TAGS = FILE_TAGS + EMBEDDED_TAGS
 
+# Slot order of the 24 int32 values in an index entry, matching Rockbox's
+# enum tag_type exactly.
+#
+# This is deliberately NOT `FILE_TAGS + EMBEDDED_TAGS`. That concatenation puts
+# canonicalartist at slot 9 and pushes year/discnumber/tracknumber to 10/11/12,
+# but Rockbox reads year at 9, discnumber at 10, tracknumber at 11 and
+# canonicalartist at 12. Serialising in FILE_TAGS+EMBEDDED_TAGS order makes
+# Rockbox read the disc number as the track number (so albums lose their track
+# ordering and fall back to alphabetical) and the release year as the disc
+# number.
+#
+# FILE_TAGS still governs *which* tag files exist and their filenames via
+# FILE_TAG_INDICES; only the index-entry slot order is defined here.
+INDEX_ORDER = [
+    "artist",  # 0  tag_artist
+    "album",  # 1  tag_album
+    "genre",  # 2  tag_genre
+    "title",  # 3  tag_title
+    "path",  # 4  tag_filename
+    "composer",  # 5  tag_composer
+    "comment",  # 6  tag_comment
+    "album artist",  # 7  tag_albumartist
+    "grouping",  # 8  tag_grouping
+    "date",  # 9  tag_year
+    "discnumber",  # 10 tag_discnumber
+    "tracknumber",  # 11 tag_tracknumber
+    "canonicalartist",  # 12 tag_virt_canonicalartist
+    "bitrate",  # 13 tag_bitrate
+    "length",  # 14 tag_length
+    "playcount",  # 15 tag_playcount
+    "rating",  # 16 tag_rating
+    "playtime",  # 17 tag_playtime
+    "lastplayed",  # 18 tag_lastplayed
+    "commitid",  # 19 tag_commitid
+    "mtime",  # 20 tag_mtime
+    "lastelapsed",  # 21 tag_lastelapsed
+    "lastoffset",  # 22 tag_lastoffset
+    "flag",  # 23 index_entry.flag
+]
+
+# Same membership as TAGS, only reordered -- guard against drift.
+assert set(INDEX_ORDER) == set(TAGS), "INDEX_ORDER must cover exactly TAGS"
+assert len(INDEX_ORDER) == len(TAGS), "INDEX_ORDER must not duplicate fields"
+
+# Fields serialised as tag-file offsets rather than raw numbers.
+FILE_TAGS_SET = frozenset(FILE_TAGS)
+
 # Index Entry Flag Definitions (from tagcache.c)
 FLAG_DELETED = 0x0001  # Entry has been removed from db
 FLAG_DIRCACHE = 0x0002  # Filename is a dircache pointer (memory only)
